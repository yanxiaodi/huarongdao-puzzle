    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "fast-xml-parser": "^5.2.5",
    "opencc-js": "^1.4.2",
    "typescript": "~5.9.2",
    "vite": "^7.1.7"
